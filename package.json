{
  "name": "smart-tijori",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "next dev client",
    "build": "next build client",
    "start": "next start client",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen client && tsc --noEmit",
    "setup:opensearch": "tsx infra/setup-index.ts",
    "seed:opensearch": "tsx infra/seed-opensearch.ts",
    "sync:postgres-products": "node --conditions=react-server --env-file-if-exists=client/.env.local --import tsx infra/sync-postgres-products.ts",
    "test:contracts": "node --conditions=react-server --import tsx --test tests/contracts-and-fixtures.test.ts tests/postgres-product-facts-reader.unit.test.ts",
    "test:opensearch": "tsx --test tests/opensearch-projection.test.ts",
    "test:search": "tsx --test tests/discovery-search.test.ts",
    "test:api": "tsx --test tests/products-api.test.ts",
    "demo:search": "tsx infra/demo-search.ts",
    "test": "node --test tests/*.test.mjs",
    "test:services": "node --conditions=react-server --test tests/services.unit.mjs",
    "check:services": "node --conditions=react-server --env-file-if-exists=client/.env.local server/check-services.mjs",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=client/.env.local server/db/run-migrations.ts",
    "worker": "node --conditions=react-server --env-file-if-exists=client/.env.local server/run-worker.ts",
    "test:platform": "node --conditions=react-server --test tests/platform.integration.mjs",
    "dev:shopping": "SMARTTIJORI_DEMO_MODE=true next dev client",
    "test:unit": "vitest run tests/unit",
    "test:http": "vitest run tests/http",
    "test:security": "vitest run tests/security",
    "test:browser": "vitest run tests/browser",
    "test:shopping": "vitest run tests/unit tests/http tests/security tests/browser"
  },
  "dependencies": {
    "cookie": "^2.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "@confluentinc/kafka-javascript": "1.11.0",
    "@opensearch-project/opensearch": "3.10.0",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/cookie": "^1.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "^11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
