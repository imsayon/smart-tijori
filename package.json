{
  "name": "smart-tijori",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "next dev client",
    "build": "next build client",
    "start": "next start client",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen client && tsc --noEmit",
    "setup:opensearch": "tsx infra/setup-index.ts",
    "seed:opensearch": "tsx infra/seed-opensearch.ts",
    "test:contracts": "tsx --test tests/contracts-and-fixtures.test.ts",
    "test:opensearch": "tsx --test tests/opensearch-projection.test.ts",
    "test:search": "tsx --test tests/discovery-search.test.ts",
    "test:api": "tsx --test tests/products-api.test.ts",
    "demo:search": "tsx infra/demo-search.ts",
    "test": "node --test tests/*.test.mjs",
    "test:services": "node --conditions=react-server --test tests/services.unit.mjs",
    "check:services": "node --conditions=react-server --env-file-if-exists=client/.env.local server/check-services.mjs"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@opensearch-project/opensearch": "3.10.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/generator": "7.29.14",
      "@babel/helper-string-parser": "7.29.14",
      "@babel/helpers": "7.29.14",
      "@babel/parser": "7.29.14",
      "@babel/traverse": "7.29.14",
      "@babel/types": "7.29.14"
    }
  }
}
