# The foundation needs no environment variables. These are reserved names only.
# Next app: copy to client/.env.local when adding live adapters.
# The future worker receives injected variables or an explicit Node --env-file.
# Never put secrets in NEXT_PUBLIC_*.
# Keep certificate/key files in ignored secrets/ or outside the checkout.

# PostgreSQL: service URI (including encoded user/password), verified TLS CA.
DATABASE_URL=
DATABASE_CA_CERT_PATH=

# Kafka: use the service's actual TLS endpoint and authentication method.
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_CA_CERT_PATH=
# SASL_SSL: mechanism and credentials from Aiven (normally SCRAM-SHA-256).
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# SSL/mTLS alternative: certificate/key instead of SASL credentials.
KAFKA_CLIENT_CERT_PATH=
KAFKA_CLIENT_KEY_PATH=
# Choose isolated development topic/group names before any future provisioning.
KAFKA_TOPIC=
KAFKA_GROUP_ID=

# OpenSearch: HTTPS endpoint without credentials; separate service user/password.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Only needed if the endpoint's CA is not already trusted by Node.
OPENSEARCH_CA_CERT_PATH=
OPENSEARCH_INDEX=
