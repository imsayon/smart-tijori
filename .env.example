# Local fixture mode uses pnpm dev:shopping and needs no service credentials.
# Next app and check:services: copy to client/.env.local, then fill private values.
# Worker and migrations use injected variables or client/.env.local.
# Never put secrets in NEXT_PUBLIC_*.
# Keep certificate/key files in ignored secrets/ or outside the checkout.

# PostgreSQL: service URI (including encoded user/password), verified TLS CA.
DATABASE_URL=
DATABASE_CA_CERT_PATH=
ST_DB_SCHEMA=
# Use opensearch for the indexed hosted catalog or postgres for literal search.
ST_CATALOG_SOURCE=

# Kafka: use the service's actual TLS endpoint and authentication method.
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_CA_CERT_PATH=
# SASL_SSL: mechanism and credentials from Aiven (normally SCRAM-SHA-256).
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Current shared Kafka uses SSL/mTLS: client certificate/key plus the Kafka CA.
KAFKA_CLIENT_CERT_PATH=
KAFKA_CLIENT_KEY_PATH=
# Use explicitly agreed topic and group names. The worker does not create topics.
KAFKA_TOPIC=
KAFKA_GROUP_ID=

# OpenSearch: HTTPS endpoint without credentials; separate service user/password.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Only needed if the endpoint's CA is not already trusted by Node.
OPENSEARCH_CA_CERT_PATH=
OPENSEARCH_INDEX=

# Live workbench credential and its authorized branch.
ST_OPS_OPERATOR_TOKEN=
ST_OPS_STORE_ID=

# Web accounts (Firebase Auth)
SESSION_SECRET=
ST_FIREBASE_PROJECT_ID=cents-lab-32d71
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_ST_FIREBASE_API_KEY=
NEXT_PUBLIC_ST_FIREBASE_PROJECT_ID=cents-lab-32d71
NEXT_PUBLIC_ST_FIREBASE_AUTH_DOMAIN=cents-lab-32d71.firebaseapp.com

# Optional, explicitly approved synthetic India-wide demo seed. Never auto-enable on production.
ST_ALLOW_INDIA_DEMO_SEED=false

# Optional server-side AI assistance. Never expose the API key in a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Online checkout (Razorpay Test Mode until a live release is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ST_ENABLE_LIVE_PAYMENTS=false
