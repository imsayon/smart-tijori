{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./client/*"
      ],
      "@server/*": [
        "./server/*"
      ],
      "@ai/*": [
        "./ai/*"
      ],
      "@/server/*": [
        "./server/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.tsx",
    "client/.next/types/**/*.ts",
    "client/.next/dev/types/**/*.ts",
    "server/**/*.ts",
    "ai/**/*.ts",
    "tests/**/*.ts",
    "client/test/**/*.ts",
    "client/test/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
